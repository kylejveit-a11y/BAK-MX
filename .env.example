# BAK MX only. Never copy EMOTO production environment values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. A smaller, faster model for the lookup-planning step, and a second model tried when the first fails.
OPENAI_PLAN_MODEL=
OPENAI_BACKUP_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Plan prices (monthly and yearly each listed): premium:price_...,premium:price_...,pro:price_...,pro:price_... STRIPE_PRICE_ID counts as Pro.
STRIPE_PLAN_PRICES=
# One-time Stripe prices for credit packs: price_...:25,price_...:100
STRIPE_CREDIT_PRICES=
APP_URL=
# Beta allowance for every rider while AI_ACCESS_MODE=beta.
AI_MAX_DAILY_REQUESTS=40
# Plan allowances once AI_ACCESS_MODE=subscription (defaults shown). Pro is unlimited with this fair-use ceiling.
AI_DAILY_FREE=0
AI_DAILY_PREMIUM=100
AI_DAILY_PRO=300
# Free trial: sets of questions a new account gets, and questions per set.
AI_TRIAL_BLOCKS=7
AI_TRIAL_BLOCK_SIZE=20
BUILD_SHA=development
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Store subscription products: Pro (MOBILE_PRODUCT_IDS or MOBILE_PRO_PRODUCT_IDS) and Premium.
MOBILE_PRODUCT_IDS=
MOBILE_PRO_PRODUCT_IDS=
MOBILE_PREMIUM_PRODUCT_IDS=
# Store consumable credit packs: product_id:credits,product_id:credits
CREDIT_PACKS_STORE=
APP_ENV=production
ALLOW_SANDBOX_PURCHASES=false

# beta: every rider gets AI_MAX_DAILY_REQUESTS a day (plans can raise it). subscription: launch rules (Free trial sets, Premium, Pro, credits).
AI_ACCESS_MODE=beta
