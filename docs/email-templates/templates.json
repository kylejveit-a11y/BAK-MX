[{"key": "confirmation", "name": "Confirm sign up", "subject": "Confirm your BAK MX account", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Confirm your email</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">One tap and your Garage is ready.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">Confirm your email</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">You\u2019re one tap from your Garage. Confirm this is your email and BAK MX is ready to go: your bike\u2019s specs, setup and service, plus answers about your exact bike.</td></tr>\n<tr><td style=\"padding:8px 0 4px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#2F74E8\" style=\"border-radius:26px;background:#2F74E8;background-image:linear-gradient(180deg,#5B95F2,#2F74E8 55%,#2462CC)\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 34px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:26px\">Confirm my email</a></td></tr></table></td></tr>\n<tr><td style=\"padding:18px 0 0;font-size:13px;line-height:20px;color:#8f97a4\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#8ab8ff;word-break:break-all;text-decoration:none\">{{ .ConfirmationURL }}</a></td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">You\u2019re getting this because someone signed up for BAK MX with {{ .Email }}. If that wasn\u2019t you, ignore this email and no account will be made.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}, {"key": "recovery", "name": "Reset password", "subject": "Reset your BAK MX password", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Reset your password</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Choose a new password for BAK MX.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">Reset your password</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">Tap below on your phone to choose a new password for <span style=\"color:#f3f5f8\">{{ .Email }}</span>. The link works once and expires soon.</td></tr>\n<tr><td style=\"padding:8px 0 4px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#2F74E8\" style=\"border-radius:26px;background:#2F74E8;background-image:linear-gradient(180deg,#5B95F2,#2F74E8 55%,#2462CC)\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 34px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:26px\">Choose a new password</a></td></tr></table></td></tr>\n<tr><td style=\"padding:18px 0 0;font-size:13px;line-height:20px;color:#8f97a4\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#8ab8ff;word-break:break-all;text-decoration:none\">{{ .ConfirmationURL }}</a></td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">Didn\u2019t ask for this? Ignore it. Your password stays the same and nobody can change it without this link.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}, {"key": "email_change", "name": "Change email address", "subject": "Confirm your new BAK MX email", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Confirm your new email</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Confirm the new email on your BAK MX account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">Confirm your new email</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">You asked to change your BAK MX email from <span style=\"color:#f3f5f8\">{{ .Email }}</span> to <span style=\"color:#f3f5f8\">{{ .NewEmail }}</span>. Tap below to confirm. Nothing changes until you do.</td></tr>\n<tr><td style=\"padding:8px 0 4px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#2F74E8\" style=\"border-radius:26px;background:#2F74E8;background-image:linear-gradient(180deg,#5B95F2,#2F74E8 55%,#2462CC)\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:15px 34px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:26px\">Confirm new email</a></td></tr></table></td></tr>\n<tr><td style=\"padding:18px 0 0;font-size:13px;line-height:20px;color:#8f97a4\">Button not working? Copy this link into your browser:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#8ab8ff;word-break:break-all;text-decoration:none\">{{ .ConfirmationURL }}</a></td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">Didn\u2019t ask for this? Ignore this email and your account keeps its current email.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}, {"key": "password_changed_notification", "name": "Password changed (Security)", "subject": "Your BAK MX password was changed", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Your password was changed</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Your BAK MX password was just changed.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">Your password was changed</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">The password for your BAK MX account <span style=\"color:#f3f5f8\">{{ .Email }}</span> was just changed. If that was you, you\u2019re all set.</td></tr>\n\n<tr><td style=\"padding:0;font-size:15px;line-height:23px;color:#c9cfd8\"><strong style=\"color:#f3f5f8\">Wasn\u2019t you?</strong> Open BAK MX, tap <em>Forgot password</em> to take your account back, then email <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a>.</td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">This is a security notice. It\u2019s sent every time your password changes.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}, {"key": "email_changed_notification", "name": "Email address changed (Security)", "subject": "Your BAK MX email was changed", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>Your email was changed</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">The email on your BAK MX account was changed.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">Your email was changed</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">The email on your BAK MX account was changed from <span style=\"color:#f3f5f8\">{{ .OldEmail }}</span> to <span style=\"color:#f3f5f8\">{{ .Email }}</span>.</td></tr>\n\n<tr><td style=\"padding:0;font-size:15px;line-height:23px;color:#c9cfd8\"><strong style=\"color:#f3f5f8\">Wasn\u2019t you?</strong> Email <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> right away and we\u2019ll lock it down.</td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">This is a security notice sent to your old and new email.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}, {"key": "identity_linked_notification", "name": "Sign-in method linked (Security)", "subject": "A new sign-in was added to your BAK MX account", "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><meta name=\"supported-color-schemes\" content=\"dark\"><title>New sign-in added</title></head>\n<body style=\"margin:0;padding:0;background:#07080a\" bgcolor=\"#07080a\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">A new way to sign in was added to BAK MX.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#07080a\" style=\"background:#07080a\"><tr><td align=\"center\" style=\"padding:36px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 22px\"><img src=\"https://bakmx.com/bak-mx-logo.png\" width=\"168\" alt=\"BAK MX\" style=\"display:block;width:168px;height:auto;border:0\"></td></tr>\n<tr><td bgcolor=\"#121418\" style=\"background:#121418;border:1px solid #23272f;border-top-color:#343a45;border-radius:18px;padding:30px 28px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif\">\n<tr><td style=\"padding:0 0 4px\"><div style=\"width:34px;height:3px;background:#6AA4FF;border-radius:2px;font-size:0;line-height:0\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:12px 0 10px;font-size:24px;line-height:30px;font-weight:800;color:#f3f5f8;letter-spacing:-0.3px\">New sign-in added</td></tr>\n<tr><td style=\"padding:0 0 18px;font-size:16px;line-height:24px;color:#c9cfd8\">You can now sign in to BAK MX (<span style=\"color:#f3f5f8\">{{ .Email }}</span>) with <span style=\"color:#f3f5f8\">{{ .Provider }}</span>. Same Garage, same history.</td></tr>\n\n<tr><td style=\"padding:0;font-size:15px;line-height:23px;color:#c9cfd8\"><strong style=\"color:#f3f5f8\">Wasn\u2019t you?</strong> Email <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> right away.</td></tr>\n</table></td></tr>\n<tr><td style=\"padding:20px 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:19px;color:#7d8593\">This is a security notice.<br><br>BAK MX \u00b7 Know what works before your next ride.<br>Questions? <a href=\"mailto:support@bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">support@bakmx.com</a> \u00b7 <a href=\"https://bakmx.com\" style=\"color:#8ab8ff;text-decoration:none\">bakmx.com</a></td></tr>\n</table></td></tr></table></body></html>"}]