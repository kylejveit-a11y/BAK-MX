{
  "name": "bakmx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --experimental-strip-types scripts/dev-server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-captures.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs tests/evaluation/*.test.mjs",
    "research:coverage": "node scripts/research-coverage.mjs",
    "research:parts": "node --experimental-strip-types scripts/normalize-parts-research.ts && node --experimental-strip-types scripts/build-parts-inventory.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:mobile": "npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "0.462.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
